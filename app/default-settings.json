    "radius": 12,
    "shadow": "soft",
    "quoteStyle": "line",
    "tableStyle": "striped",
    "separatorStyle": "fade",
    "scrollbarWidth": "regular"
  },
  "branding": {
    "showHeader": true,
    "showLogo": false,
    "showFileName": true,
    "showFilePath": false,
    "title": "MarkLens",
    "workspace": "Markdown Reader",
    "logoFile": null,
    "useLogoAsFavicon": true
  },
  "behavior": {
    "showTableOfContents": true,
    "autoHideToolbar": false
  },
  "customPresets": []
}
